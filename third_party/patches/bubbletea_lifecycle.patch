-// shutdown performs operations to free up resources and restore the terminal
-// to its original state.
+// launch records accepted work before spawning. Shutdown closes launch sources
+// before waiting. Commands must be immediate or honor their owned context.
+func (p *Program) launch(fn func()) {
+	p.taskMu.Lock()
+	if p.taskClosing {
+		p.taskMu.Unlock()
+		return
+	}
+	p.tasks.Add(1)
+	p.taskMu.Unlock()
+	go func() {
+		defer p.tasks.Done()
+		if !p.disableCatchPanics {
+			defer func() {
+				if r := recover(); r != nil {
+					p.recoverFromGoPanic(r)
+				}
+			}()
+		}
+		fn()
+	}()
+}
