diff --git a/mica_lifecycle_test.go b/mica_lifecycle_test.go
--- /dev/null
+++ b/mica_lifecycle_test.go
@@ -0,0 +1,170 @@
+package zeroconf
+
+import (
+	"context"
+	"github.com/miekg/dns"
+	"golang.org/x/net/ipv4"
+	"golang.org/x/net/ipv6"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+func loopbackPacket(t *testing.T) *ipv4.PacketConn {
+	t.Helper()
+	conn, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { conn.Close() })
+	return ipv4.NewPacketConn(conn)
+}
+func TestMicaMulticastWriteError(t *testing.T) {
+	conn := loopbackPacket(t)
+	conn.Close()
+	s := &Server{ipv4conn: conn, shouldShutdown: make(chan struct{})}
+	if err := s.multicastResponse(new(dns.Msg), 1); err == nil {
+		t.Fatal("multicast dropped socket write/deadline error")
+	}
+}
+func TestMicaClientReturnsAfterReaderCleanup(t *testing.T) {
+	conn := loopbackPacket(t)
+	c := &client{ipv4conn: conn}
+	ctx, cancel := context.WithCancel(context.Background())
+	params := defaultParams("_mica-mesh._tcp")
+	params.isBrowsing = true
+	entries := make(chan *ServiceEntry)
+	params.Entries = entries
+	done := make(chan error, 1)
+	go func() { done <- c.run(ctx, params) }()
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("browser did not join")
+	}
+	if _, ok := <-entries; ok {
+		t.Fatal("results open after completion")
+	}
+	if err := conn.SetReadDeadline(time.Now()); err == nil {
+		t.Fatal("socket open after completion")
+	}
+}
+func TestMicaConcurrentShutdownJoinsProbe(t *testing.T) {
+	s := &Server{service: newServiceEntry("instance", "_mica-mesh._tcp", "local."), shouldShutdown: make(chan struct{})}
+	s.service.HostName = "test.local."
+	s.service.Port = 1234
+	s.service.AddrIPv4 = []net.IP{net.ParseIP("192.0.2.1")}
+	s.ipv4conn = loopbackPacket(t)
+	if err := s.start(); err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	for range 8 {
+		wg.Add(1)
+		go func() { defer wg.Done(); s.Shutdown() }()
+	}
+	done := make(chan struct{})
+	go func() { wg.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("shutdown did not join")
+	}
+}
+func TestMicaUnreadResultsCancel(t *testing.T) {
+	raw, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	c := &client{ipv4conn: ipv4.NewPacketConn(raw)}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	params := defaultParams("_mica-mesh._tcp")
+	params.isBrowsing = true
+	entries := make(chan *ServiceEntry)
+	params.Entries = entries
+	done := make(chan struct{})
+	go func() { defer close(done); c.mainloop(ctx, params) }()
+	message := new(dns.Msg)
+	for _, instance := range []string{"one", "two"} {
+		name := instance + "._mica-mesh._tcp.local."
+		host := instance + ".local."
+		message.Answer = append(message.Answer, &dns.SRV{Hdr: dns.RR_Header{Name: name, Rrtype: dns.TypeSRV, Class: dns.ClassINET, Ttl: 120}, Port: 1234, Target: host}, &dns.A{Hdr: dns.RR_Header{Name: host, Rrtype: dns.TypeA, Class: dns.ClassINET, Ttl: 120}, A: net.ParseIP("192.0.2.1")})
+	}
+	packet, err := message.Pack()
+	if err != nil {
+		t.Fatal(err)
+	}
+	writer, err := net.Dial("udp4", raw.LocalAddr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer writer.Close()
+	if _, err := writer.Write(packet); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-entries:
+	case <-time.After(time.Second):
+		t.Fatal("first result missing")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("unread second result stranded browser")
+	}
+}
+func TestMicaStoppedServerSkipsWrites(t *testing.T) {
+	conn := loopbackPacket(t)
+	conn.Close()
+	s := &Server{ipv4conn: conn, shouldShutdown: make(chan struct{})}
+	close(s.shouldShutdown)
+	if err := s.multicastResponse(new(dns.Msg), 1); err != nil {
+		t.Fatalf("stopped sender touched socket: %v", err)
+	}
+	if err := s.unicastResponse(new(dns.Msg), 0, &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 1}); err != nil {
+		t.Fatalf("stopped unicast touched socket: %v", err)
+	}
+}
+func TestMicaWriteDeadlineBoundsSocket(t *testing.T) {
+	conn := loopbackPacket(t)
+	s := &Server{ipv4conn: conn}
+	if err := s.setWriteDeadline(time.Now().Add(-time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	_, err := conn.WriteTo([]byte("test"), nil, &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 1})
+	if e, ok := err.(net.Error); !ok || !e.Timeout() {
+		t.Fatalf("write was not deadline-bounded: %v", err)
+	}
+}
+func TestMicaCanceledQuerySkipsWrites(t *testing.T) {
+	conn := loopbackPacket(t)
+	conn.Close()
+	c := &client{ipv4conn: conn}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := c.sendQuery(ctx, new(dns.Msg)); err != context.Canceled {
+		t.Fatalf("query ignored cancellation: %v", err)
+	}
+}
+
+func TestMicaIPv4ProxyRejectsMissingIPv4Socket(t *testing.T) {
+	raw, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	s := &Server{service: newServiceEntry("instance", "_mica-mesh._tcp", "local."), ipv6conn: ipv6.NewPacketConn(raw), shouldShutdown: make(chan struct{})}
+	s.service.AddrIPv4 = []net.IP{net.ParseIP("192.0.2.1")}
+	if err := s.start(); err == nil {
+		s.Shutdown()
+		t.Fatal("IPv4-only proxy started without IPv4 socket")
+	}
+	if err := raw.SetReadDeadline(time.Now()); err == nil {
+		t.Fatal("partial IPv6 socket leaked")
+	}
+}
