load("@rules_go//go:def.bzl", "go_test")

# Preserve the established mesh_test label and one execution of this suite.
# Gazelle's package-derived name would add a duplicate integration_test rule.
# gazelle:ignore

go_test(
    name = "mesh_test",
    size = "medium",
    srcs = [
        "mesh_test.go",
        "session_test.go",
    ],
    deps = [
        "//internal/client",
        "//internal/controller",
        "//internal/protocol",
        "//internal/runtime",
        "//internal/testutil/fakeruntime",
        "//internal/worker",
        "//protocol/mesh/v1:mesh",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//credentials/insecure",
        "@org_golang_google_grpc//status",
    ],
)

filegroup(
    name = "format_srcs",
    srcs = glob(["*.go"]) + ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
