load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "terminal",
    srcs = [
        "commands.go",
        "console.go",
        "descriptor.go",
        "editor.go",
        "effects.go",
        "input.go",
        "model.go",
        "names.go",
        "panels.go",
        "sanitize.go",
        "session.go",
        "style.go",
        "view.go",
    ],
    importpath = "github.com/AbhinavSingh95/mica-mesh/internal/terminal",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/app",
        "//internal/client",
        "//internal/config",
        "//internal/discovery",
        "//internal/doctor",
        "//internal/protocol",
        "//internal/setup",
        "//protocol/mesh/v1:mesh",
        "@com_github_charmbracelet_colorprofile//:colorprofile",
        "@com_github_charmbracelet_x_term//:term",
        "@com_github_google_uuid//:uuid",
        "@com_github_muesli_cancelreader//:cancelreader",
        "@land_charm_bubbles_v2//key",
        "@land_charm_bubbles_v2//progress",
        "@land_charm_bubbles_v2//textarea",
        "@land_charm_bubbletea_v2//:bubbletea",
        "@land_charm_lipgloss_v2//:lipgloss",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_x_sys//unix",
    ],
)

go_test(
    name = "terminal_test",
    srcs = [
        "commands_test.go",
        "console_darwin_test.go",
        "editor_test.go",
        "flow_test.go",
        "input_test.go",
        "library_test.go",
        "lifetime_test.go",
        "model_test.go",
        "names_test.go",
        "presentation_test.go",
        "request_test.go",
        "session_io_darwin_test.go",
        "session_test.go",
        "two_worker_test.go",
    ],
    embed = [":terminal"],
    deps = [
        "//internal/app",
        "//internal/config",
        "//internal/controller",
        "//internal/discovery",
        "//internal/doctor",
        "//internal/protocol",
        "//internal/runtime",
        "//internal/setup",
        "//internal/testutil/fakeruntime",
        "//internal/worker",
        "//protocol/mesh/v1:mesh",
        "@com_github_charmbracelet_ultraviolet//:ultraviolet",
        "@com_github_charmbracelet_x_ansi//:ansi",
        "@com_github_google_uuid//:uuid",
        "@com_github_muesli_cancelreader//:cancelreader",
        "@land_charm_bubbletea_v2//:bubbletea",
        "@land_charm_lipgloss_v2//:lipgloss",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ] + select({
        "@rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:ios": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "format_srcs",
    srcs = glob(["*.go"]) + ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
