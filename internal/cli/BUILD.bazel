load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cli",
    srcs = [
        "cli.go",
        "command.go",
        "doctor.go",
        "interactive.go",
        "mode.go",
        "setup.go",
    ],
    importpath = "github.com/AbhinavSingh95/mica-mesh/internal/cli",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/app",
        "//internal/client",
        "//internal/config",
        "//internal/discovery",
        "//internal/doctor",
        "//internal/protocol",
        "//internal/setup",
        "//internal/terminal",
        "//protocol/mesh/v1:mesh",
        "@com_github_google_uuid//:uuid",
    ],
)

go_test(
    name = "cli_test",
    size = "small",
    srcs = [
        "cli_test.go",
        "command_test.go",
        "interactive_test.go",
        "mode_test.go",
        "setup_test.go",
    ],
    embed = [":cli"],
    deps = [
        "//internal/app",
        "//internal/config",
        "//internal/protocol",
        "//internal/setup",
        "//protocol/mesh/v1:mesh",
        "@com_github_google_uuid//:uuid",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

filegroup(
    name = "format_srcs",
    srcs = glob(["*.go"]) + ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)
