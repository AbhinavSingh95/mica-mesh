load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@rules_go//proto:def.bzl", "go_proto_library")

# gazelle:default_visibility //visibility:private

package(default_visibility = ["//visibility:private"])

# This test-only service exercises both code generators before the mesh API exists.
proto_library(
    name = "smoke_proto",
    testonly = True,
    srcs = ["smoke.proto"],
    visibility = ["//visibility:private"],
)

go_proto_library(
    name = "smoke_go_proto",
    testonly = True,
    compilers = [
        "@rules_go//proto:go_grpc_v2",
        "@rules_go//proto:go_proto",
    ],
    importpath = "github.com/AbhinavSingh95/mica-mesh/tools/toolchain",
    proto = ":smoke_proto",
    visibility = ["//visibility:private"],
)

go_test(
    name = "toolchain_test",
    size = "small",
    srcs = ["smoke_test.go"],
    deps = [
        ":toolchain",
        "@org_golang_google_protobuf//proto",
    ],
)

filegroup(
    name = "format_srcs",
    srcs = glob(["*.go"]) + ["BUILD.bazel"],
    visibility = ["//:__pkg__"],
)

go_library(
    name = "toolchain",
    testonly = True,
    embed = [":smoke_go_proto"],
    importpath = "github.com/AbhinavSingh95/mica-mesh/tools/toolchain",
    visibility = ["//visibility:private"],
)
