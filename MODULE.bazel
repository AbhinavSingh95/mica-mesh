module(name = "mica_mesh")

bazel_dep(name = "rules_go", version = "0.64.1")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "rules_shell", version = "0.6.1")

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(
    name = "go_sdk",
    go_mod = "//:go.mod",
)
go_sdk.nogo(
    includes = [
        "//cmd:__subpackages__",
        "//internal:__subpackages__",
    ],
    nogo = "//:nogo",
)
use_repo(go_sdk, "go_sdk")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
go_deps.module_override(
    patch_strip = 1,
    patches = ["//third_party/patches:zeroconf_lifecycle.patch"],
    path = "github.com/libp2p/zeroconf/v2",
)
use_repo(go_deps, "com_github_google_uuid", "com_github_libp2p_zeroconf_v2", "org_golang_google_grpc", "org_golang_google_grpc_cmd_protoc_gen_go_grpc", "org_golang_google_protobuf", "org_golang_x_sys")
